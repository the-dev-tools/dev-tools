version: 2
workspace_name: Golden WebSocket
run:
    - flow: WebSocketFlow
flows:
    - name: WebSocketFlow
      steps:
        - manual_start:
            name: Start
            position_x: 0
            position_y: 0
        - ws_connection:
            name: Conn
            depends_on: Start
            position_x: 300
            position_y: 0
            url: wss://echo.example.com/socket
            headers:
                Authorization: Bearer token123
        - ws_send:
            name: SendPing
            depends_on: Conn
            position_x: 600
            position_y: 0
            ws_connection_node_name: Conn
            message: '{"type":"ping"}'
        - wait:
            name: WaitForPong
            depends_on: SendPing
            position_x: 900
            position_y: 0
            duration_ms: "500"
        - ws_send:
            name: SendClose
            depends_on: WaitForPong
            position_x: 1200
            position_y: 0
            ws_connection_node_name: Conn
            message: '{"type":"close"}'
