workspace_name: Golden JS Wait
run:
    - flow: JsWaitFlow
flows:
    - name: JsWaitFlow
      steps:
        - manual_start:
            name: Start
            position_x: 0
            position_y: 0
        - js:
            name: ComputeDelay
            depends_on: Start
            position_x: 300
            position_y: 0
            code: |-
                export default function(context) {
                  return { delayMs: 250 };
                }
        - wait:
            name: PauseBriefly
            depends_on: ComputeDelay
            position_x: 600
            position_y: 0
            duration_ms: "250"
        - js:
            name: AfterWait
            depends_on: PauseBriefly
            position_x: 900
            position_y: 0
            code: |-
                export default function(context) {
                  return { done: true };
                }
